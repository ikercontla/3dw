# Configuración opcional de conexión a SQL Server local (TAYO_WMS)
# Si SQL Server no está activo o faltan credenciales, el servidor Express y el cliente
# operan automáticamente en "Motor en Memoria" sincronizado con scripts/simulacion_operaciones.sql.

PORT=3001
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=TAYO_WMS
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
